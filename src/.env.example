# Nojo remote MCP server configuration.
# Copy to src/.env:  cp src/.env.example src/.env
# Real environment variables take precedence over the file.

# The three URLs below currently point at the Nojo staging host. Production is
# https://nojo.ai / https://nojo.ai/mcp / https://nojo.ai/oauth/token. All three
# must move together: the backend binds tokens to the resource identifier and
# compares the issuer as an exact string.

# --- OAuth (required) --------------------------------------------------------
# The Nojo backend's authorization server, exactly as its metadata advertises
# the issuer. No trailing slash: RFC 8414 compares issuers by exact string.
NOJO_ISSUER_URL=https://41.38.196.107.nip.io
# The exact public URL clients connect to, including the /mcp path. The 401
# challenge and the protected-resource metadata route are both derived from it,
# so a mismatch here breaks OAuth discovery with no useful error.
NOJO_RESOURCE_SERVER_URL=https://41.38.196.107.nip.io/mcp

# --- Platform API (required) -------------------------------------------------
# Base URL for the Nojo platform's own resource APIs (farms, crops, alerts,
# stations, ...). Called with the exchanged Nojo JWT, never the caller's raw
# OAuth token.
NOJO_API_BASE_URL=https://41.38.196.107.nip.io/api
# Endpoint paths, relative to NOJO_API_BASE_URL.
NOJO_FARMS_OVERVIEW_PATH=/farms/overview
NOJO_FARMS_PATH=/farms
NOJO_FARM_PATH=/farms/{farm_id}
NOJO_CROP_PATH=/crops/{crop_id}
NOJO_CROPS_PATH=/crops
NOJO_CROP_OPTIONS_PATH=/crops/options

# --- Token exchange (required) -----------------------------------------------
# The backend endpoint that exchanges a client's OAuth access token for a
# short-lived Nojo JWT (RFC 8693). This server authenticates to it with its own
# client credentials; keep the secret out of version control (0600 file).
TOKEN_EXCHANGE_URL=https://41.38.196.107.nip.io/oauth/token
MCP_OAUTH_CLIENT_ID=nojo-mcp
MCP_OAUTH_CLIENT_SECRET=

# --- HTTP server -------------------------------------------------------------
HOST=0.0.0.0
# Must include the public hostname or every proxied request is rejected with 421.
ALLOWED_HOSTS=41.38.196.107.nip.io
ALLOWED_ORIGINS=
# Sessions live in a per-process dict. Leave false unless you run several
# replicas without sticky routing.
STATELESS_HTTP=false

# --- HTTP client -------------------------------------------------------------
# Used only for the token exchange call to the backend.
HTTP_TIMEOUT_SECONDS=15.0
# The pool is shared by every user of the server.
HTTP_MAX_CONNECTIONS=100

# --- Behaviour ---------------------------------------------------------------
LOG_LEVEL=INFO
