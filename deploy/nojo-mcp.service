[Unit]
Description=Nojo MCP server (Streamable HTTP)
After=network.target

[Service]
User=fms-test
Group=fms-test
WorkingDirectory=/home/fms-test/Nojo-MCP

ExecStart=/home/fms-test/.local/bin/uv run uvicorn src.app:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1 --workers 1

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
